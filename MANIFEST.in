include LICENSE.txt
include README.rst
include CHANGES.rst
include COMPATIBILITY.rst
include requirements.txt
include tox.ini
include setup.py
recursive-include cython *.pyx
recursive-include cython *.pxd
recursive-include rust Cargo.toml
recursive-include rust/src *.rs

recursive-include tests *
recursive-include docs *

global-exclude __pycache__
global-exclude *.py[co]
global-exclude .token
global-exclude .*.sw*

prune docs/source/api
